{
  "name": "super-lazy-boy-room",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --config github-pages/vite.config.ts",
    "build": "node scripts/build-github.mjs",
    "build:github": "node scripts/build-github.mjs",
    "preview": "vite preview --config github-pages/vite.config.ts",
    "test:public": "node --test scripts/public-records.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:interaction": "node --test scripts/room-navigation.test.mjs scripts/frame-events.test.mjs scripts/record-print.test.mjs scripts/collectibles.test.mjs",
    "test:performance": "node --test scripts/room-performance.test.mjs",
    "test:loading": "node --test scripts/room-loading.test.mjs scripts/room-first-frame.test.mjs",
    "test:clearance": "node --test scripts/scene-clearance.test.mjs scripts/motion-clearance.test.mjs scripts/memory-drawer.test.mjs",
    "test:permissions": "node --test scripts/room-permissions.test.mjs",
    "check:backend": "node scripts/check-backend.mjs",
    "test:e2e": "playwright test",
    "records:restore": "node scripts/restore-public-records.mjs",
    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.0",
    "@react-three/fiber": "9.3.0",
    "@react-three/postprocessing": "^3.0.4",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.31.0",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.37.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.180.0",
    "three-mesh-bvh": "^0.9.18",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "6.0.2",
    "meshoptimizer": "0.22.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
